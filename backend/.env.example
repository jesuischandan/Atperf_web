# Copy to backend/.env and fill in. Never commit the real file.

# ── Database (MariaDB / MySQL) — required ──
GCP_DB_USER=atperf_admin
GCP_DB_PASSWORD=change-me
GCP_DB_HOST=127.0.0.1
GCP_DB_PORT=3306
GCP_DB_NAME=atperf
# Or a full SQLAlchemy URL, which overrides the five values above:
# GCP_DATABASE_URL=sqlite:///./local.db

# ── Sessions — required in production ──
# Long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If missing, a random key is generated at start-up and every restart logs everyone out.
JWT_SECRET=
SESSION_DAYS=7

# ── Origins allowed to call the API with cookies (comma-separated) ──
CORS_ORIGINS=https://atperf.com,https://www.atperf.com,http://localhost:35000,http://127.0.0.1:35000

# ── OpenAI ──
OPENAI_API_KEY=sk-your_openai_api_key

# ── Email (OTP & PDF delivery) ──
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
